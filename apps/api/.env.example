# HTTP server
PORT=3000

# JCP Firebase project
FIREBASE_PROJECT_ID=jain-community-platform

# Render/non-Google server credentials.
# Prefer FIREBASE_SERVICE_ACCOUNT_JSON_BASE64 or FIREBASE_PRIVATE_KEY_BASE64.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_BASE64=
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# Optional first-deploy bootstrap. Set to true only while provisioning the first tenant/admin.
FIREBASE_BOOTSTRAP_ENABLED=false
FIREBASE_BOOTSTRAP_TENANT_ID=
FIREBASE_BOOTSTRAP_TENANT_SLUG=
FIREBASE_BOOTSTRAP_TENANT_NAME=
FIREBASE_BOOTSTRAP_TENANT_HOSTNAME=
FIREBASE_BOOTSTRAP_ADMIN_SUBJECT=
FIREBASE_BOOTSTRAP_ADMIN_EMAIL=
FIREBASE_BOOTSTRAP_ADMIN_NAME=

# Redis remains an optional future infrastructure dependency.
REDIS_URL=

# Firebase Authentication token verification
AUTH_ISSUER=https://securetoken.google.com/jain-community-platform
AUTH_AUDIENCE=jain-community-platform
AUTH_JWKS_URL=https://www.googleapis.com/robot/v1/metadata/x509/securetoken@system.gserviceaccount.com
